<container flexDirection="column" alignItems="center" gap="3" padding="8">
  <text fontSize="20" fontWeight="bold" color="#44ff44" textAlign="center">PICK CATEGORY</text>
  <container flexDirection="row" gap="3" justifyContent="center" flexWrap="wrap" width="380">
    <text name="btn-ANIMALS" fontSize="12" color="#00ffff" backgroundColor="#003344" padding="4" borderRadius="4" textAlign="center" width="115">ANIMALS</text>
    <text name="btn-SPACE" fontSize="12" color="#aa44ff" backgroundColor="#220044" padding="4" borderRadius="4" textAlign="center" width="115">SPACE</text>
    <text name="btn-FOOD" fontSize="12" color="#ffaa00" backgroundColor="#332200" padding="4" borderRadius="4" textAlign="center" width="115">FOOD</text>
    <text name="btn-TECH" fontSize="12" color="#4488ff" backgroundColor="#001133" padding="4" borderRadius="4" textAlign="center" width="115">TECH</text>
    <text name="btn-COLORS" fontSize="12" color="#ff44ff" backgroundColor="#330033" padding="4" borderRadius="4" textAlign="center" width="115">COLORS</text>
    <text name="btn-SPORTS" fontSize="12" color="#44ff44" backgroundColor="#003300" padding="4" borderRadius="4" textAlign="center" width="115">SPORTS</text>
    <text name="btn-MUSIC" fontSize="12" color="#ff8844" backgroundColor="#331100" padding="4" borderRadius="4" textAlign="center" width="115">MUSIC</text>
    <text name="btn-NATURE" fontSize="12" color="#88ccff" backgroundColor="#112233" padding="4" borderRadius="4" textAlign="center" width="115">NATURE</text>
    <text name="btn-WEATHER" fontSize="12" color="#ffff44" backgroundColor="#333300" padding="4" borderRadius="4" textAlign="center" width="115">WEATHER</text>
    <text name="btn-OCEAN" fontSize="12" color="#00aaff" backgroundColor="#002244" padding="4" borderRadius="4" textAlign="center" width="115">OCEAN</text>
    <text name="btn-TRAVEL" fontSize="12" color="#ff6688" backgroundColor="#331122" padding="4" borderRadius="4" textAlign="center" width="115">TRAVEL</text>
    <text name="btn-MYTHICAL" fontSize="12" color="#ffcc44" backgroundColor="#332200" padding="4" borderRadius="4" textAlign="center" width="115">MYTHICAL</text>
    <text name="btn-SCIENCE" fontSize="12" color="#66ffcc" backgroundColor="#003322" padding="4" borderRadius="4" textAlign="center" width="115">SCIENCE</text>
    <text name="btn-FASHION" fontSize="12" color="#ff88cc" backgroundColor="#330022" padding="4" borderRadius="4" textAlign="center" width="115">FASHION</text>
