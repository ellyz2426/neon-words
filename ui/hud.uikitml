<container flexDirection="row" gap="12" padding="6" backgroundColor="#00000088" borderRadius="4">
  <container flexDirection="column" alignItems="center">
    <text fontSize="10" color="#888888">SCORE</text>
    <text name="score" fontSize="16" fontWeight="bold" color="#00ffff">0</text>
  </container>
  <container flexDirection="column" alignItems="center">
    <text fontSize="10" color="#888888">WORDS</text>
    <text name="words" fontSize="16" fontWeight="bold" color="#44ff44">0/8</text>
  </container>
  <container flexDirection="column" alignItems="center">
    <text fontSize="10" color="#888888">TIME</text>
    <text name="time" fontSize="16" fontWeight="bold" color="#ffaa00">--</text>
  </container>
  <container flexDirection="column" alignItems="center">
    <text fontSize="10" color="#888888">COMBO</text>
    <text name="combo" fontSize="16" fontWeight="bold" color="#ff44ff">x1</text>
  </container>
  <container flexDirection="column" alignItems="center">
    <text fontSize="10" color="#888888">MODE</text>
    <text name="mode" fontSize="12" color="#aaaaaa">CLASSIC</text>
  </container>
</container>
