<container flexDirection="column" alignItems="center" gap="8" padding="10">
  <text fontSize="22" fontWeight="bold" color="#00ffff" textAlign="center">DIFFICULTY</text>
  <container flexDirection="column" gap="5" alignItems="center">
    <text name="btn-easy" fontSize="16" color="#44ff44" backgroundColor="#003300" padding="8" borderRadius="4" textAlign="center" width="200">EASY (8x8)</text>
    <text name="btn-medium" fontSize="16" color="#ffaa00" backgroundColor="#332200" padding="8" borderRadius="4" textAlign="center" width="200">MEDIUM (10x10)</text>
    <text name="btn-hard" fontSize="16" color="#ff4444" backgroundColor="#330000" padding="8" borderRadius="4" textAlign="center" width="200">HARD (12x12)</text>
  </container>
  <text name="btn-back" fontSize="14" color="#ff4444" backgroundColor="#330000" padding="5" borderRadius="4" textAlign="center" width="120">BACK</text>
</container>
